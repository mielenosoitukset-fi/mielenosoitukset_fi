[Unit]
Description=Weekly full MongoDB backup for mielenosoitukset.fi (including audit logs)
After=network-online.target
Wants=network-online.target
OnFailure=mielenosoitukset-backup-failed.service
# Start the encrypted off-site copy once the dump is verified (systemd 249+).
OnSuccess=mielenosoitukset-offsite-copy.service

[Service]
Type=oneshot
Environment=BACKUP_MODE=full
Environment=KEEP_DAYS=35
ExecStart=/var/www/mielenosoitukset_fi/deploy/backup/mongodb-backup.sh
# Known archive: about 420 MB, about 7 minutes at 1 MiB/s. 90 minutes keeps the run
# inside the night window; a longer run is killed and alerts.
RuntimeMaxSec=5400
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/backups/mielenosoitukset
ReadOnlyPaths=/var/www/mielenosoitukset_fi
