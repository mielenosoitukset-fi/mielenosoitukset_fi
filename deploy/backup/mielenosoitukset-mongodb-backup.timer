[Unit]
Description=Nightly MongoDB backup for mielenosoitukset.fi

[Timer]
# Monday to Saturday; Sunday has the full dump. 01:30 UTC is 03:30 Helsinki in
# winter and 04:30 in summer, inside the 03:00-05:00 night window all year (the
# random delay adds up to 15 minutes).
OnCalendar=Mon..Sat *-*-* 01:30:00 UTC
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
