[Unit]
Description=Weekly full MongoDB backup for mielenosoitukset.fi

[Timer]
# Same time as the core dump (they never overlap: core skips Sunday). 01:30 UTC
# is 03:30 Helsinki in winter and 04:30 in summer.
OnCalendar=Sun *-*-* 01:30:00 UTC
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
