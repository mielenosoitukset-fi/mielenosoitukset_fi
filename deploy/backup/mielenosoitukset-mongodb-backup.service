[Unit]
Description=Nightly core MongoDB backup for mielenosoitukset.fi (without audit logs)
After=network-online.target
Wants=network-online.target
OnFailure=mielenosoitukset-backup-failed.service
# Start the encrypted off-site copy once the dump is verified (systemd 249+).
OnSuccess=mielenosoitukset-offsite-copy.service

[Service]
Type=oneshot
Environment=BACKUP_MODE=core
ExecStart=/var/www/mielenosoitukset_fi/deploy/backup/mongodb-backup.sh
# Known archive: about 61 MB, about 1 minute at the 1 MiB/s cap. A run still going
# after an hour is stuck or the database is slow: kill it and alert.
RuntimeMaxSec=3600
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/backups/mielenosoitukset
ReadOnlyPaths=/var/www/mielenosoitukset_fi
