[Unit]
Description=Daily catch-up for the off-site MongoDB backup copy

# The copy normally starts right after each backup (OnSuccess= in the backup
# services). This timer retries anything that failed or was missed; the ledger
# makes a second run a no-op.
[Timer]
# 01:50 UTC is 03:50 Helsinki in winter, 04:50 in summer: night window, after the
# dumps (01:30 UTC plus up to 15 minutes). Not Persistent, so a boot by day never
# starts a copy; the next night picks the archives up.
OnCalendar=*-*-* 01:50:00 UTC

[Install]
WantedBy=timers.target
