{
  "extraKnownMarketplaces": {
    "oliviaos": { "source": { "source": "github", "repo": "botsarefuture/oliviaos-skill" } }
  },
  "enabledPlugins": {
    "oliviaos-guard@oliviaos": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/quiet-commands.py\"" }
        ]
      }
    ]
  }
}
